# 页面与API无需登录。以下只用于服务器连接你现有的数据库。
HOST=127.0.0.1
PORT=8090
# DATABASE_URL=postgresql://existing_user:existing_password@127.0.0.1:5432/cosmic_atlas
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGDATABASE=cosmic_atlas
# PGPASSWORD=
REDIS_URL=redis://127.0.0.1:6379
# 无可用PG连接时自动使用SQLite；不修改现有PG或Redis配置。
